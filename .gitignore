# The aggregate repository publishes only the normalized supplementary tree.
*
!/.gitignore
!/Supplementary_materials/
!/Supplementary_materials/**/

# Analysis and workflow scripts must live below a Scripts directory.
!/Supplementary_materials/**/Scripts/**/*.py
!/Supplementary_materials/**/Scripts/**/*.R
!/Supplementary_materials/**/Scripts/**/*.r
!/Supplementary_materials/**/Scripts/**/*.sh
!/Supplementary_materials/**/Scripts/**/*.bash
!/Supplementary_materials/**/Scripts/**/*.zsh
!/Supplementary_materials/**/Scripts/**/*.pl
!/Supplementary_materials/**/Scripts/**/*.jl
!/Supplementary_materials/**/Scripts/**/*.ipynb
!/Supplementary_materials/**/Scripts/**/*.Rmd
!/Supplementary_materials/**/Scripts/**/*.qmd

# Result artifacts are restricted to PNG files below Results directories.
!/Supplementary_materials/**/Results/**/*.png
!/Supplementary_materials/**/Results/**/*.PNG
